# Copy this file to .env.local and fill in values.
# .env.local is gitignored; .env.example is safe to commit.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated HMAC key for signing the admin impersonation cookie (SEC-H1). OPTIONAL: if unset, the
# code falls back to SUPABASE_SERVICE_ROLE_KEY (so leaving this blank is non-breaking). Set it to a
# long random value (e.g. `openssl rand -base64 48`) so a future service-role-key leak can't also
# forge impersonation cookies. Setting/rotating it invalidates any in-flight impersonation sessions.
IMPERSONATION_SIGNING_SECRET=

# App
# Local dev: http://localhost:3000
# Production (Ticket / restaurant vertical): https://app.getticket.ai
# Drives every server-built absolute URL: magic link redirects, OAuth callbacks,
# Stripe success/cancel/return URLs, transactional email links, internal
# self-fetch URLs in cron jobs. MUST match the canonical public origin in the
# environment it's set in -- a stale value silently breaks auth and billing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override the Resend From address per brand. Leave unset in
# production once `getticket.ai` (Ticket) and `useneat.ai` (Neat, future) are
# verified sending domains in Resend. The fallbacks in lib/email/send.ts use
# those domains, so once DKIM/SPF/DMARC are live the env vars become unused.
# Set these only if you need to send from a Resend-test domain (onboarding@resend.dev)
# while domain verification is pending.
RESEND_FROM_TICKET=
RESEND_FROM_NEAT=

# DataForSEO
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY= # optional

# Stripe
# Generated by `npx tsx scripts/stripe/setup.ts` — see scripts/stripe/README.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ticket (restaurants) — 6 prices
STRIPE_PRICE_ID_TICKET_ENTRY_MONTHLY=
STRIPE_PRICE_ID_TICKET_ENTRY_ANNUAL=
STRIPE_PRICE_ID_TICKET_MID_MONTHLY=
STRIPE_PRICE_ID_TICKET_MID_ANNUAL=
STRIPE_PRICE_ID_TICKET_TOP_MONTHLY=
STRIPE_PRICE_ID_TICKET_TOP_ANNUAL=

# ALT-687 — metered add-on prices. Both brands point at the SAME price ID: the add-on product is
# brand-neutral, the lookup is per brand. Created by scripts/stripe/setup.ts.
# Until these are set, resolveAddOnPriceInfo returns null for every item, purchased quantities stay
# 0, and every effective cap equals the plan's included allowance. That is the safe default.
STRIPE_PRICE_ID_TICKET_ADDON_LOCATION_MONTHLY=
STRIPE_PRICE_ID_TICKET_ADDON_LOCATION_ANNUAL=
STRIPE_PRICE_ID_TICKET_ADDON_COMPETITOR_MONTHLY=
STRIPE_PRICE_ID_TICKET_ADDON_COMPETITOR_ANNUAL=
STRIPE_PRICE_ID_NEAT_ADDON_LOCATION_MONTHLY=
STRIPE_PRICE_ID_NEAT_ADDON_LOCATION_ANNUAL=
STRIPE_PRICE_ID_NEAT_ADDON_COMPETITOR_MONTHLY=
STRIPE_PRICE_ID_NEAT_ADDON_COMPETITOR_ANNUAL=

# Neat (liquor stores) — 6 prices
STRIPE_PRICE_ID_NEAT_ENTRY_MONTHLY=
STRIPE_PRICE_ID_NEAT_ENTRY_ANNUAL=
STRIPE_PRICE_ID_NEAT_MID_MONTHLY=
STRIPE_PRICE_ID_NEAT_MID_ANNUAL=
STRIPE_PRICE_ID_NEAT_TOP_MONTHLY=
STRIPE_PRICE_ID_NEAT_TOP_ANNUAL=

# Customer Portal configurations (per brand — distinct branding/headlines)
STRIPE_PORTAL_CONFIG_TICKET=
STRIPE_PORTAL_CONFIG_NEAT=

# LLM (optional in V1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
LITELLM_PROXY_URL=

# Adaptive-thinking EFFORT dials (all optional; unset = the defaults shown, which are the values
# that were previously hardcoded). low | medium | high only — anything else warns and falls back,
# because an invalid effort 400s the call and silently degrades it to a deterministic fallback.
# ANTHROPIC_PRODUCER_EFFORT is the highest-leverage cost lever: it drives the parallel expert
# fan-out, which dominates per-brief spend. Sweep these against evals rather than guessing.
ANTHROPIC_PRODUCER_EFFORT=medium
ANTHROPIC_DEEP_EFFORT=high
ANTHROPIC_SYNTHESIS_EFFORT=high
ANTHROPIC_FUSION_EFFORT=medium
ANTHROPIC_WRITE_EFFORT=medium

# Light interactive model (optional; unset = claude-haiku-4-5). Drives the small, latency-sensitive
# surfaces that moved off Gemini in beta rescue 2.2: quick-tip, on-demand insight generation, and
# the insights pipeline's narrative/review-theme call.
# ANTHROPIC_FAST_MODEL=

# Per-brief spend ceiling in USD. UNSET = DISABLED, which is the deliberate default: there is no
# observed-spend baseline yet, and a ceiling guessed too low silently degrades good briefs. Read the
# $/brief figures off /admin/health for a week, then set this to a multiple of observed p95.
# When set, a build whose spend-so-far crosses it runs its REMAINING model calls one effort notch
# cheaper. It never aborts a build: a cheaper complete brief beats a half-built one, and aborting
# would land in the deterministic-fallback path. Crossings are logged and recorded on the brief
# (providerStats.spendDegradedCalls), so a degraded build is visible rather than silent.
# ANTHROPIC_PER_BRIEF_CEILING_USD=

# Nightly quality judge (/api/cron/eval-judge). EVAL_JUDGE_SAMPLE is the SPEND DIAL: one model call
# per brief judged, ~$0.06 each, so the default 10/night is roughly $18/mo. EVAL_JUDGE_DROP_ALERT is
# the drop in mean judge score (1-5 scale) versus the trailing mean that fires a Slack alert.
EVAL_JUDGE_SAMPLE=10
EVAL_JUDGE_DROP_ALERT=0.3

# Fleet-wide daily USD cap (a TRIPWIRE, not a budget target). UNSET = DISABLED, deliberately: a cap
# guessed too low is a self-inflicted outage that stops every brief. Once tripped, /api/cron/build-brief
# refuses to start ANY build for the rest of the UTC day and posts a Slack alert; override a single run
# with ?ignoreCap=1. Set from a week of real daily totals (sum of providerStats.estimatedUsd), as a
# MULTIPLE of observed. Fails OPEN: if the spend query errors, briefs still build.
# ANTHROPIC_FLEET_DAILY_CAP_USD=

# Google Cloud / OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps & Places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Firecrawl
FIRECRAWL_API_KEY=

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=

# Outscraper
OUTSCRAPER_API_KEY=

# Data365
DATA365_ACCESS_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=

# Cron
CRON_SECRET=

# PostHog (product analytics + session replay)
# NEXT_PUBLIC_POSTHOG_KEY is the project API key (phc_...), browser-safe.
# NEXT_PUBLIC_POSTHOG_HOST points at our /ingest reverse proxy (configured in
# next.config.ts) to bypass tracker-blocking extensions. In local dev you can
# set this to https://us.i.posthog.com to bypass the proxy entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Feature flags
VERTICALIZATION_ENABLED=false
# Gates client-facing transactional emails (waitlist confirmation, welcome,
# trial reminders) behind the sendEmail() gateway. Admin-initiated flows and
# user-initiated auth (self-service magic link) bypass via overrideClientEmailPause.
# false in production (Chris's Resend drip handles marketing), true in dev/preview.
CLIENT_EMAILS_ENABLED=true
# D6 gate: the weekly digest's OWN send switch. The digest cron hard-stops
# unless this is exactly "true" -- a per-email override in the spirit of
# overrideClientEmailPause, so enabling the digest NEVER requires flipping
# CLIENT_EMAILS_ENABLED (which would also unpause welcome + waitlist-confirm).
# Leave false/unset until Bryan's digest content review clears.
WEEKLY_DIGEST_EMAILS_ENABLED=false
# Optional digest dials: local send hour (default 8) and catch-up window in
# hours (default 4) -- see lib/email/digest-schedule.ts.
# WEEKLY_DIGEST_LOCAL_HOUR=8
# WEEKLY_DIGEST_CATCHUP_HOURS=4
# Gates the product-side mirror into `marketing.contacts`. Must stay false until
# Chris's Phase 3 marketing schema migration has been applied to the target
# Supabase project AND `marketing` has been added to Settings -> API ->
# Exposed schemas. When false, upsertMarketingContact() no-ops silently.
MARKETING_CONTACTS_ENABLED=false
